			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.2.0</version>
				<executions>
					<execution>
						<id>blanco-meta-anttask</id>
						<phase>generate-sources</phase>
						<configuration>
							<target>
								<taskdef name="blancoanttask" classname="blanco.anttask.task.BlancoAntTaskTask" classpath="${blanco.generator.classpath}">
								</taskdef>
								<blancoanttask metadir="meta/program" encoding="${project.build.sourceEncoding}" />
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>

					<execution>
						<id>blanco-meta-constants</id>
						<phase>generate-sources</phase>
						<configuration>
							<target>
								<taskdef name="blancoconstants" classname="blanco.constants.task.BlancoConstantsTask" classpath="${blanco.generator.classpath}">
								</taskdef>
								<blancoconstants metadir="meta/program" encoding="${project.build.sourceEncoding}" />
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>

					<execution>
						<id>blanco-meta-resourcebundle</id>
						<phase>generate-sources</phase>
						<configuration>
							<target>
								<taskdef name="blancoresourcebundle" classname="blanco.resourcebundle.task.BlancoResourceBundleTask" classpath="${blanco.generator.classpath}">
								</taskdef>
								<blancoresourcebundle metadir="meta/program" encoding="${project.build.sourceEncoding}" commenttimestamp="false" />
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>

					<execution>
						<id>blanco-meta-valueobject</id>
						<phase>generate-sources</phase>
						<configuration>
							<target>
								<taskdef name="blancovalueobject" classname="blanco.valueobject.task.BlancoValueObjectTask" classpath="${blanco.generator.classpath}">
								</taskdef>
								<blancovalueobject metadir="meta/program" encoding="${project.build.sourceEncoding}" />
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>

					<execution>
						<id>blanco-meta-meta2xml</id>
						<phase>generate-sources</phase>
						<configuration>
							<target>
								<whichresource property="blanco.bootstrap.source" resource="blanco/meta2xml/task/BlancoMeta2XmlTask.class"
									classpath="${blanco.generator.classpath}" />
								<echo level="info" message="Bootstrap generator: ${blanco.bootstrap.source}" />
								<taskdef name="blancometa2xml" classname="blanco.meta2xml.task.BlancoMeta2XmlTask" classpath="${blanco.generator.classpath}">
								</taskdef>
								<blancometa2xml metadir="meta/program" encoding="${project.build.sourceEncoding}" targetdir="blanco" />
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>

					<execution>
						<id>blanco-project-version</id>
						<phase>process-sources</phase>
						<goals><goal>run</goal></goals>
						<configuration>
							<target><ant antfile="build.xml" target="stamp-version" inheritAll="false" /></target>
						</configuration>
					</execution>

					<execution>
						<id>blanco-clean</id>
						<phase>clean</phase>
						<configuration>
							<target>
								<delete dir="tmp" />
								<delete dir="blanco" />
								<delete dir="bin" />
								<delete dir="classes" />
								<mkdir dir="bin" />
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>
				</executions>
